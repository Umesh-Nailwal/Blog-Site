<% layout('base', {title :"Edit Blog - BlogSphere"}) %>
<main class="form-main">
    <h2 class="form-heading">Edit Blog</h2>
    <form action="/user_profile/edit_blog" method="POST" enctype="multipart/form-data">
      <section class="form-group">
        <label>Blog Title</label>
        <input name="title" value="" type="text" required placeholder="Enter blog title">
      </section>
      <section class="form-group">
        <label>Summary</label>
        <input name="summary" value="" type="text" required placeholder="Write a short summary">
      </section>
      <section class="form-group">
        <label>Blog Content</label>
        <textarea name="content" required rows="12" cols="30" placeholder="Enter your blog..">content</textarea>
      </section>
      <section class="form-group">
        <label>Category</label>
        <select name="category" required multiple>
          <option  value="Web Development">Web Development</option>
          <option value="AI">AI </option>
          <option value="Full Stack">Full Stack</option>
        </select>
      </section>
      <section class="form-group">
        <label>Featured Image (Max size -5MB)</label>
        <img class="blog-photo" src="" alt="blog image">
        <input name="featured-file" type="file" accept="image/*" required>
      </section>
      <button type="submit" class="btn">Add Blog</button>
    </form>
  </main>