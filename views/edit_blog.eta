<% layout('base', {title :"Edit Blog - BlogSphere"}) %>
<main class="main-content">
    <h1>Edit Your Profile</h1>
      <form action="/auth/register" method="POST" enctype="multipart/form-data">
        <div class="form-group">
          <label for="fullname">Full Name</label>
          <input type="text" value="Umesh Chandra" id="fullname" name="fullname" required placeholder="Enter your full name">
        </div>

        
        <div class="form-group">
          <label for="email">Email Address</label>
          <input type="email" id="email" readonly name="email" required placeholder="name@example.com">
        </div>

       <div class="form-group">
        <label>Profile Banner (Max size -5MB)</label>
        <img class="user-banner" src="/publi/default_banner.svg" alt="blog image">
        <input name="featured-file" type="file" accept="image/*" required>
      </div>
        
      <div class="form-group">
        <label>Profile Avatar (Max size -5MB)</label>
        <img class="user-pic-large" src="/public/default_avatar.png" alt="blog image">
        <input name="featured-file" type="file" accept="image/*" required>
      </div>

        <div>
          <button class="btn" type="submit">Register</button>
        </div>
      </form>

      <p>Already have an account? <a class="anchor link" href="/auth/login">Log In</a></p>
    </section>
  </main>

  