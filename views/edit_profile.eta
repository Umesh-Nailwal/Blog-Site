<% layout('base', {title :"Edit Blog - BlogSphere"}) %>
<main class="main-content">
    <h1>Edit Your Profile</h1>
      <form action="/user_profile/edit_profile" method="POST" enctype="multipart/form-data">
        <div class="form-group">
          <label for="fullname">Full Name</label>
          <input type="text" value=<%= it.profile.name %> id="name" name="fullname"  placeholder="Enter your full name">
        </div>
        
       <div class="form-group">
        <label>Profile Banner (Max size -5MB)</label>
        <img class="user-banner" src=<%= `/authors/banner/${it.profile.banner}`  %> alt="profile banner">
        <input name="banner" type="file" accept="image/*" >
      </div>
        
      <div class="form-group">
        <label>Profile Avatar (Max size -5MB)</label>
        <img class="user-pic-large" src=<%= `/authors/avatar/${it.profile.avatar}`  %> alt="profile avatar">
        <input name="avatar" type="file" accept="image/*">
      </div>

        <div>
          <button class="btn" type="submit">Edit Profile</button>
        </div>
      </form>

    </section>
  </main>