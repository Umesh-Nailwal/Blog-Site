<% layout('base', { title: "Blog - BlogSphere"}) %>
  <% if(it.blog) { %>
<main class="main-content">
    <section class="blog-hero-section">
      <div class="blog-date">
        <i class="fa-regular fa-calendar" ></i>
      <span class="blog-posted-date"><%= new Date( it.blog.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
      </div>
      <h1 class="blog-title"><%= it.blog.title %></h1>
      <p class="blog-summary"> <%= it.blog.summary %></p>
      <p class="blog-categories">
        <span class="blog-category"><%= it.blog.category %></span>
      </p>
    </section>
    <section class="blog-main-img" style="background-image: url('<%= `/blog-image/${it.blog.image}` %>');">
    </section>
    <div class="blog-para" >
       <%~ it.blog.content %>
    </div>
<% } %>
  </main>